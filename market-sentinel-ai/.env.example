# =============================================================================
# Market Sentinel AI - Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to source control.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@db:5432/market_sentinel

# --- Redis (Celery broker / cache) ---
REDIS_URL=redis://redis:6379/0

# --- AI / OpenAI-compatible ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Alpaca Broker ---
# Paper trading endpoint (default - safe)
ALPACA_API_KEY=your-alpaca-paper-key
ALPACA_SECRET_KEY=your-alpaca-paper-secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Safety Flags (DO NOT change defaults without understanding risks) ---
PAPER_TRADING_ONLY=true
REAL_TRADING_ENABLED=false

# --- Risk Limits ---
MAX_DAILY_LOSS_USD=50
MAX_TRADE_SIZE_USD=25
MAX_OPEN_POSITIONS=5
MIN_CONFIDENCE_TO_TRADE=80
MIN_CONFIDENCE_FOR_ALERT=50
ALLOW_SHORTING=false
ALLOW_OPTIONS=false

# --- Notifications: Telegram ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Notifications: Email (SMTP) ---
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com

# --- News APIs (optional - app works with mock data without these) ---
NEWSAPI_KEY=your-newsapi-key
ALPHAVATAGE_KEY=your-alpha-vantage-key

# --- Social APIs (optional) ---
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# --- App Settings ---
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
